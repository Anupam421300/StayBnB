<% layout("/layouts/biolerplate") %>
<script>
const coordinates = <%- JSON.stringify(list.geometry.coordinates) %>;

  </script>



  <div class="card col-6 offset-2 show-card listing-card">
    <h1>
      <%=list.title%>
    </h1>
    <img src="<%=list.image.url%>" class="card-img-top show-img" alt="...">
    <div class="card-body">
      <p class="card-text">
        <%=list.tile%>
          <!-- <h1><%=list.title%></h1> -->
          <p><i> <b>owned by </b>
              <%=list.owner.username%>
            </i></p>
          <p><b><i>description</i></b>:- <%=list.description%>
          </p>
          <p><b>amount charge is :- &#8377 <%=list.price.toLocaleString("en-IN")%></b></p>

          <p><b>location:- </b>
            <%=list.location%>
          </p>
          <p><b>country:- </b>
            <%=list.country%>
          </p>


          <br>
          <% if(currUser && currUser._id.equals(list.owner._id)){ %>

            <div class="btns ">

              <form method="get" action="/listings/<%=list._id%>/edit">
                <button class="btn  btnss btn-dark">Edit</button>
              </form>
              <br>

              <form method="post" action="/listings/<%=list._id%>?_method=DELETE">
                <button class="btn btn-d offset-4 btn-dark">delete</button>
              </form>

            </div>
            <%}%>






              <div class="col-8 offset- ">
                <hr>


                <% if(currUser) { %>
                  <h4>Leave the Review</h4>
                  <form action="/listings/<%=list._id%>/reviews" method="POST" novalidate class="needs-validation
            ">


                    <div class="mt-3 mb-3">
                      <label for="rating" class="from-label">Rating</label>
                      <fieldset class="starability-slot" >
                        <input type="radio" id="no-rate"  name="review[rating]" value="1"  hidden  />
                        <input type="radio" id="first-rate5" name="review[rating]" value="1" />
                        <label for="first-rate5" title="Amazing"> 1stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="2" />
                        <label for="first-rate4" title="Very good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average"> 3 stars</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="4" />
                        <label for="first-rate2" title="Not good">4 stars</label>
                        <input type="radio" id="first-rate1" name="review[rating]" value="5" />
                        <label for="first-rate1" title="Terrible">5 star</label>
                      </fieldset>
                    </div>
                    <div class="mt-3 mb-3">
                      <label for="comment" class="form-label">Comments</label>
                      <textarea required class="form-control" name="review[comment]" id="comment" col="30"
                        row="5"></textarea>
                      <div class="invalid-feedback">please submit some commnet for review </div>
                    </div>
                    <br>
                    <button class="btn btn-outline-dark">Submit
                    </button>
                  </form>
                  <hr>
                  <%}%>
              </div>


              <% if(list.reviews.length>0){ %>

                <p><b>All Reviews</b></p>
                <div class="row">
                  <% for (review of list.reviews){ %>
                    <div class="card col-5 ms-3 mb-3">
                      <div class="card-body">
                        <h5 class="card-title">@<%= review.author.username%>
                        </h5>
                        <p class="card-text">
                        <div class="strability-result" data-rating=<%=review.rating%> aria-describedby="rated-element">
                          3 stars
                        </div>
      </p>
      <p class="card-text">
        <%= review.comment%>
      </p>


    </div>
 
    
 <%   if(currUser && currUser._id.equals(review.author._id)){%>
    <form class="mb-3" action="/listings/<%=list._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
      <button class="btn btn-sm btn-dark ">
        Delete
      </button>
    </form>

<% }%>
 
  

    
  </div>

  <% }%> <!-- to display reviews from array one by one  -->
    </div>

   <!-- to  check the review length  --> <%}%>
      </p>

     
 </div>
      </div>
       <div class="col-6 offset-2 mb-3">
        <div id="map">
          <h3> Where you'll be</h3>
      

        </div>
         </div>
     


      </div>

      <script src="/js/map.js" ></script>