<% layout("/layouts/biolerplate.ejs") %>

<div class="row mt-3 mb-3">
  <h1 class="col-8 offset-3">SignUp on Wnaderlust</h1>
  <div class="col-8 offset-2">
    <form action="/signup" method="post"  class="needs-validation" novalidate>
          
      <!--Username-->
      <div class="mb-3"> 
        <label for="username" class="form-label">Username</label>
        <input 
        type="text"
         name="username" 
        id="username"
         class="form-control" 
         required>
        <div class="valid-feedback">Looks Good !</div>
      </div>

      <!--email -->
      <div class="mb-3"> 
        <label for="email" class="form-label">Email</label>
        <input 
        type="email"
         name="email" 
         id="email"
         class="form-control" 
         required>
          <div class="invalid-feedback">Enter the email in correct format</div>
    


         <!--password-->
      </div>
      <div class="mb-3"> 
        <label for="password" class="form-label">Password</label>
        <input 
        type="password"
         name="password" 
        id="password"
         class="form-control" 
         required>
       
      </div>

      <!--submit button -->
      <button class="btn btn-success">
        Sign Up
      </button>

    </form>




  </div>
  </div>